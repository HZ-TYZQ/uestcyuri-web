---
import { Image } from 'astro:assets';
import BrandName from './BrandName.astro';
import { siteData } from '../lib/content';
import { pic } from '../lib/images';
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---
<div class="wrap">
	<header class="site-header">
		<a class="brand" href="/" aria-label={`${siteData.name.replace('♥', '')} 首页`}>
			<Image src={pic(siteData.logo)} alt="" width={92} loading="eager" />
			<span>
				<span class="brand-name"><BrandName text={siteData.name} /></span>
				<span class="brand-sub">{siteData.subtitle}</span>
			</span>
		</a>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">目录</button>
		<nav class="nav" id="site-nav" aria-label="主导航">
			{siteData.pages.map((page) => <a href={`/${page.id}/`} aria-current={currentPath === `/${page.id}` ? 'page' : undefined}>{page.title}</a>)}
		</nav>
	</header>
</div>
