---
import BrandName from './BrandName.astro';
import { siteData } from '../lib/content';
---
<footer class="wrap site-footer">
	<div class="footer-main">
		<div>
			<span class="footer-name"><BrandName text={siteData.name} /> · {siteData.groupName}</span>
			<small>{siteData.footer.copyright}</small>
			<small>
				网页源码以 <a href={`${siteData.repo}/blob/main/LICENSE`} target="_blank" rel="noopener license">MIT 协议</a>开源 ·
				<a href={siteData.repo} target="_blank" rel="noopener">GitHub</a>
			</small>
		</div>
		{siteData.footer.signoffFrom ? (
			<p class="footer-signoff">{siteData.footer.signoff}<cite>——《{siteData.footer.signoffFrom}》</cite></p>
		) : <span class="latin">{siteData.footer.signoff}</span>}
	</div>
</footer>
