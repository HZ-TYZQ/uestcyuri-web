---
import { categories, works } from '../data/club';
import ClubImage from './ClubImage.astro';
---

<section class="section" id="works" aria-labelledby="works-title">
  <div class="section-heading">
    <div><h2 id="works-title">喜欢，也可以成为作品</h2><p class="section-intro">画下的、写下的，都是想和你分享的。</p></div>
    <span class="section-index">II. Creations / 创作</span>
  </div>
  <div class="work-toolbar">
    <div class="filters" role="group" aria-label="按作品类型筛选">
      <button class="filter" type="button" data-filter="all" aria-pressed="true">全部</button>
      {categories.map(category => <button class="filter" type="button" data-filter={category.id} aria-pressed="false">{category.label}</button>)}
    </div>
    <p class="result-status" role="status" aria-live="polite" aria-atomic="true">正在展示全部 {works.length} 件作品</p>
  </div>
  <div class="works-grid">
    {works.map(work => {
      const category = categories.find(category => category.id === work.category)!;
      return (
        <article class="work" data-category={work.category}>
          {work.excerpt?.length && !work.image?.src ? (
            <div class="manuscript work-visual">
              <span class="manuscript-label">文字摘录{work.isExample && ' · 设计示例'}</span>
              <blockquote>{work.excerpt.map((line, index) => <>{index > 0 && <br />}{line}</>)}</blockquote>
              <span class="manuscript-end">A letter, unfinished.</span>
            </div>
          ) : <ClubImage image={work.image} class="work-visual" label={category.placeholder} description={`${work.title}，${category.label}封面`} />}
          <div class="work-meta"><span>{category.label}</span>{work.isExample && <span>示例作品</span>}</div>
          <h3>{work.title}</h3><p>{work.description}</p>
        </article>
      );
    })}
  </div>
  <p class="empty-state" hidden={works.length > 0}>这个分类还没有作品，试试其他分类吧。</p>
</section>
