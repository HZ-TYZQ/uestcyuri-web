---
import { Image } from 'astro:assets';
import Heart from './Heart.astro';
import { contributorsData, siteData } from '../lib/content';
import { pic } from '../lib/images';
const { roles, materials } = contributorsData;
---
<section class="credits" id="credits" aria-labelledby="credits-title">
	<header class="credits-head">
		<span class="credits-fin latin">Colophon</span>
		<h2 id="credits-title">网页贡献者</h2>
		<p>这个网站，是群友们一起为你准备的。</p>
	</header>
	<dl class="credits-roll">
		{roles.map((r) => (
			<div class="credit">
				<dt>
					<span class="role">{r.role}</span>
					<span class="role-en">{r.en}</span>
					{r.note && <span class="role-note">{r.note}</span>}
				</dt>
				<span class="mark" aria-hidden="true"></span>
				<dd>
					{r.names.map((n, i) => {
						const name = <span class="name">{n.org && <span class="org">{n.org}</span>}{n.name}</span>;
						return i === 0 ? name : <span class="pair"><span class="amp">&amp;</span>{name}</span>;
					})}
				</dd>
			</div>
		))}
		<div class="credit">
			<dt>
				<span class="role">{materials.role}</span>
				<span class="role-en">{materials.en}</span>
				{materials.note && <span class="role-note">{materials.note}</span>}
			</dt>
			<span class="mark" aria-hidden="true"></span>
			<dd class="reel-wrap">
				<div class="reel" aria-label={materials.role}>
					<ul class="reel-track">
						{materials.people.map((p) => (
							<li><Image src={pic(p.avatar)} alt="" width={96} height={96} /><span>{p.name}</span></li>
						))}
					</ul>
				</div>
				{materials.caption && <span class="reel-note">{materials.caption}</span>}
			</dd>
		</div>
	</dl>
	{siteData.creditsQuote && (
		<blockquote class="credits-quote">
			<p>{siteData.creditsQuote.text}</p>
			<cite>——《{siteData.creditsQuote.from}》</cite>
		</blockquote>
	)}
	<p class="credits-end">
		<Heart />
		<span class="latin">fin.</span>
		<small>名单按群昵称记录</small>
	</p>
</section>
