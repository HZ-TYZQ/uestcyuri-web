---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { siteData } from '../lib/content';
const roman = ['I', 'II', 'III', 'IV', 'V'];
// 保留旧单页的分享链接，将锚点送到对应栏目。
const legacySections = Object.fromEntries(siteData.pages.flatMap((page) =>
	page.sections.map((id) => [`#${id}`, `/${page.id}/#${id}`]),
));
---
<Layout>
	<script is:inline define:vars={{ legacySections }}>
		const destination = legacySections[location.hash];
		if (destination) {
			const target = new URL(destination, location.origin);
			target.search = location.search;
			location.replace(target.href);
		}
	</script>
	<Hero />
	<nav class="wrap page-directory" aria-label="浏览栏目">
		{siteData.pages.map((page, i) => (
			<a class="directory-item" href={`/${page.id}/`}>
				<span class="section-num" aria-hidden="true">{roman[i] ?? String(i + 1)}</span>
				<div><h2>{page.title}</h2><p>{page.intro}</p></div>
				<span class="latin">{page.en}</span>
				<span class="directory-arrow" aria-hidden="true">↗</span>
			</a>
		))}
	</nav>
</Layout>
