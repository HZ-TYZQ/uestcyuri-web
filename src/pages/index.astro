---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Works from '../components/Works.astro';
import Translations from '../components/Translations.astro';
import Quotes from '../components/Quotes.astro';
import Activities from '../components/Activities.astro';
import Recommend from '../components/Recommend.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { siteData } from '../lib/content';

// 板块顺序和序号来自 src/data/site.yaml 的 sections
const components = { works: Works, translations: Translations, quotes: Quotes, activities: Activities, recommend: Recommend, about: About };
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
---
<Layout>
	<Header />
	<main id="main">
		<Hero />
		{siteData.sections.map((section, i) => {
			const Section = components[section.id];
			return <Section section={section} num={roman[i]} />;
		})}
	</main>
	<Footer />
</Layout>
