---
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';
import { siteData } from '../lib/content';
const title = `${siteData.name} · ${siteData.groupName}`;
---
<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="robots" content="noai, noimageai" />
		<meta name="description" content={siteData.description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={siteData.description} />
		<script is:inline>
			// 动效开关：系统「减少动态效果」或地址带 ?still（截图用）时不开
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !/[?&]still\b/.test(location.search)) {
				document.documentElement.classList.add('motion');
			}
		</script>
	</head>
	<body>
		<div class="progress" aria-hidden="true"></div>
		<a class="skip" href="#main">跳到正文</a>
		<svg width="0" height="0" style="position:absolute" aria-hidden="true">
			<symbol id="heart" viewBox="0 0 24 22"><path fill="currentColor" d="M12 21.3 10.5 20C5.3 15.3 2 12.3 2 8.6 2 5.5 4.4 3 7.5 3c1.7 0 3.4.8 4.5 2.1C13.1 3.8 14.8 3 16.5 3 19.6 3 22 5.5 22 8.6c0 3.7-3.3 6.7-8.5 11.4Z"></path></symbol>
		</svg>
		<slot />
		<Lightbox />
		<script>
			import '../scripts/site.ts';
		</script>
	</body>
</html>
